# ============================================================
#  .env.example — Aletheia Core
#  Copiar a .env y rellenar con tus valores reales
# ============================================================

# API Key de OpenRouter (para modelos cloud)
OPENROUTER_API_KEY="tu-api-key-aqui"

# Servidor LLM local (Ollama, LM Studio, etc.)
# En Docker Compose, usar: http://ollama:11434/v1
CUSTOM_API_BASE="http://localhost:11434/v1"

# Modelo personalizado de Ollama
CUSTOM_MODEL="aletheia-core"

# PIN de administrador raíz
ROOT_PIN="tu-pin-seguro-aqui"

# Clave del System Bridge (cabecera X-API-Key que deben enviar los satélites).
# Si se deja vacía, el puente solo escucha en 127.0.0.1 y sin autenticación.
# Generar una con: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=""

# (Opcional) Forzar el host del puente. En Docker usar 0.0.0.0 junto con BRIDGE_API_KEY.
# BRIDGE_HOST="0.0.0.0"

# (Opcional) Carpeta sandbox donde la IA puede escribir archivos. Por defecto: ./workspace
# ALETHEIA_WORKSPACE="./workspace"
